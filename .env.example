# Base da API usada pelo axios. Em dev o Vite faz proxy de /api, por isso a base é relativa.
VITE_API_URL=/api/v1

# Para onde o proxy do Vite (npm run dev / npm run preview) encaminha /api.
# Backend no Docker (FlowCred-Back docker-compose): http://localhost:8001
# Backend com uvicorn local seguindo o README do back: também http://localhost:8001
VITE_PROXY_TARGET=http://localhost:8001

# Mostrar a dica "admin / admin" na tela de login fora do modo dev (ex.: build de demonstração).
VITE_SHOW_DEMO_LOGIN=false
# Credenciais exibidas nessa dica (devem bater com INITIAL_ADMIN_* do backend).
VITE_DEMO_USERNAME=admin
VITE_DEMO_PASSWORD=admin
